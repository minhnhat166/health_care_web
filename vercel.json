{
    "version": 2,
    "framework": "vite",
    "buildCommand": "bun run build",
    "outputDirectory": "dist",
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api/$1" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "env": {
        "NODE_ENV": "production",
        "VITE_SWAGGER_URL": "https://be.bellybabe.site",
        "VITE_SWAGGER_API_URL": "https://be.bellybabe.site/api"
    },
    "cleanUrls": true,
    "trailingSlash": false
}
